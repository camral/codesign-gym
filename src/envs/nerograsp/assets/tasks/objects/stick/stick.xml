<!-- Default class "small_obj_collision" is defined in small_obj_defaults.xml -->
<mujoco>
  <worldbody>
    <!-- Simple cylinder: 13cm length, 1.3cm diameter, 25g -->
    <body name="stick" pos="0.39 0.06 0.004" quat="0.7071 0.7071 0 0">
      <!-- Real-world mass: 0.025 kg (25 g). Sim mass: 1x real -->
      <!-- fullinertia from cylinder primitive: r=0.0035, L=0.07 (half the real 13cm stick).
           Ixx=Iyy = m(3r²+L²)/12 = 0.25×(3×1.225e-5+4.9e-3)/12 = 1.028489e-4
           Izz     = m·r²/2        = 0.25×6.125e-6               = 1.53125e-6 -->
      <inertial pos="0 0 0" mass="0.025" fullinertia="1.028489e-05 1.028489e-05 1.531250e-07 0 0 0"/>
      <freejoint/>
      <geom name="stick_collision" class="small_obj_collision" type="cylinder" size="0.0035 0.035" mass="0"/>
    </body>
  </worldbody>
</mujoco> 
