<mujoco model="nero">
  <compiler angle="radian" autolimits="true" meshdir="../"/>

  <size njmax="256" nconmax="64"/>
  <option integrator="implicitfast" cone="elliptic" impratio="2" timestep="0.005" gravity="0 0 -9.81">
      <flag multiccd="disable"/>
  </option>

  <visual>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <default>
    <default class="nero">
      <geom priority="100" solref="0.01 1" solimp="0.5 0.95 0.001 0.95 100" friction="0.5"/>
    </default>
  <!-- geom class defaults -->
    <default class="visual">
      <geom group="1" type="mesh" contype="0" conaffinity="0" density="0" material="black" />
    </default>
    <!-- Rigid plastic collision bodies on palm and phalanges -->
    <default class="collision">
      <geom material="black" friction="0.8 0.005 0.0001"
            solref="0.04 1.0" solimp="0.8 0.9 0.001"/>
    </default>
    <!-- Fingertips: stiffer solimp prevents penetration into the floor, high dampratio
         prevents objects from bouncing/recoiling on contact.
         friction="0.5 0.005 0.0001" — low sliding friction; objects slide off freely.
         solref="0.02 2.0" — 20ms timeconst; dampratio=2.0 (strongly overdamped) absorbs
           collision energy so there is no recoil when the tip touches an object.
         solimp="0.85 0.99 0.005" — high d0/d1 means the tip acts nearly rigid; very
           little compression into the floor surface is allowed.
         condim=3 — no rolling-friction; objects can spin/slide off freely. -->
    <default class="soft_tip">
      <!-- contype/conaffinity=2 ensures only these geoms (and the floor, bit 3) touch the screw.
           The palm/phalanx collision boxes remain on bit 1 and pass through without contact. -->
      <geom type="mesh" material="silicone"
            contype="3" conaffinity="3"
            condim="6" solref="0.02 2.0" solimp="0.85 0.99 0.001" margin="0.0005" 
            friction="1.0 0.05 0.001"/>

      <!-- Child classes only specify what differs: the mesh and mass -->
      <default class="tip">
        <geom mesh="tip"/>
      </default>
      <default class="tip_magnetic_base">
        <geom mesh="tip_magnetic_base"/>
      </default>
      <default class="tip_plastic_base">
        <geom mesh="tip_plastic_base"/>
      </default>      
      <default class="leap_if_tip_trimesh">
        <geom mesh="leap_if_tip_trimesh"/>
      </default>
      <default class="leap_mf_tip_trimesh">
        <geom mesh="leap_mf_tip_trimesh"/>
      </default>
      <default class="leap_rf_tip_trimesh">
        <geom mesh="leap_rf_tip_trimesh"/>
      </default>
      <default class="leap_th_tip_trimesh">
        <geom mesh="leap_th_tip_trimesh"/>
      </default>
    </default>

    <!-- Cage visualisation: transparent glass, no physics, group 4 (debug-only visual layer, no collisions) -->
    <default class="cage">
      <geom group="4" type="mesh" contype="0" conaffinity="0" density="0" material="cage_glass"/>
    </default>

    <!-- https://github.com/camral/piper_leap_control/commit/d69dbb3c311deafdcb0f9e9eeff7f53c52c6702b -->
    <!-- joint class defaults , rot was range="-1.047 1.047", cmc was range="-0.47 2.04", axl was range="-2 2.094"-->
    <!-- original kp="57.8137" kv="0.960515" pierces objects; using kp="5.0" kv="0.15" forcerange="-0.3 0.3" -->
    <default class="mcp">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-0.314 2.23" />
      <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-0.314 2.23" />
    </default>
    <default class="rot">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-0.1 0.1" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-0.1 0.1" />
    </default>
    <default class="pip">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-0.506 1.885" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-0.506 1.885" />
    </default>
    <default class="dip">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-0.366 2.042" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-0.366 2.042" />
    </default>
    <default class="thumb_cmc">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="1.47 1.67" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="1.47 1.67" />
    </default>
    <default class="thumb_axl">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-0.1 0.1" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-0.1 0.1" />
    </default>
    <default class="thumb_mcp">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-1.31 1.71" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-1.31 1.71" />
    </default>
    <default class="thumb_ipl">
    <joint pos="0 0 0" axis="0 0 -1" damping="0.942626" frictionloss="0.090465" armature="0.008086"
        limited="true" range="-1.34 1.88" />
    <position kp="5.0" kv="0.15" forcerange="-0.3 0.3" ctrlrange="-1.34 1.88" />
    </default>
  </default>

