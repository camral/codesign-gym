<mujoco>
  <visual>
    <headlight ambient="0.38 0.40 0.44" diffuse="0.55 0.55 0.55" specular="0.18 0.18 0.18"/>
    <rgba haze="0.55 0.68 0.82 1"/>
    <quality shadowsize="2048"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.38 0.54 0.72" rgb2="0.08 0.13 0.20" width="512" height="512"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" width="256" height="256"
             rgb1="0.20 0.30 0.40" rgb2="0.15 0.24 0.34" markrgb="0.26 0.36 0.46"/>
    <material name="grid_mat" texture="grid" texuniform="true" texrepeat="5 5" reflectance="0.06"/>
  </asset>
  <worldbody>
    <light name="key_light" pos="0.4 -0.6 2.2" dir="-0.2 0.3 -1.0" directional="false"
           diffuse="0.82 0.84 0.88" specular="0.28 0.28 0.30" castshadow="true"/>
    <light name="fill_light" pos="-0.8 0.8 1.8" dir="0.4 -0.4 -1.0" directional="false"
           diffuse="0.30 0.34 0.42" specular="0.08 0.08 0.10" castshadow="false"/>
    <!-- plane = infinite half-space: nothing can penetrate below z=0 regardless
         of speed or timestep. conaffinity=3 (bits 1+2) keeps existing contact
         bit-mask logic: collides with objects (bit 2) and hand (bit 1). -->
    <geom name="floor" type="plane" size="2 2 0.01" material="grid_mat" rgba="1 1 1 1"
          contype="3" conaffinity="3"
          condim="6" friction="2.0 0.05 0.005"
          solref="0.0001 1.0" solimp="0.999 0.9999 0.001"/>
  </worldbody>
</mujoco>



