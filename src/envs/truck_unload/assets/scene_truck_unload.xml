<!-- Shared scene dressing: skybox, ground plane and lighting.
     Reused across environments. Attached into the WORLD frame by each env, so it
     must not contain anything robot- or task-specific. -->
<mujoco model="scene">

  <option integrator="implicitfast" timestep="0.005" cone="elliptic" impratio="3"
          iterations="20" ls_iterations="50"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.48" ambient="0.32 0.34 0.38" specular="0.1 0.1 0.1"/>
    <rgba haze="0.55 0.68 0.82 1"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="2048"/>
    <map znear="0.05" shadowclip="14"/>
  </visual>

  <asset>
    <!-- Single-compile architecture shares assets across all worlds at zero per-env memory cost -->
    <texture type="skybox" builtin="gradient" rgb1="0.34 0.58 0.88" rgb2="0.82 0.90 0.97"
             width="256" height="256"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.20 0.30 0.40" rgb2="0.15 0.24 0.34" markrgb="0.26 0.36 0.46"
             width="256" height="256"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="1.2 1.2"
              reflectance="0.06" roughness="0.80" specular="0.12"/>
  </asset>

  <worldbody>
    <!-- Warm sun key light + cool sky fill light -->
    <light pos="5 -6 10" dir="-0.35 0.55 -1.0" directional="true"
           diffuse="0.85 0.82 0.76" specular="0.25 0.25 0.22" castshadow="true"/>
    <light pos="-5 5 8" dir="0.45 -0.45 -0.85" directional="true"
           diffuse="0.24 0.30 0.38" specular="0 0 0" castshadow="false"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
