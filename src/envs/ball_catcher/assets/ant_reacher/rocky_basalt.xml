<mujoco model="rocky">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true" texturedir="rocky_textured"/>

  <asset>
    <!-- Weathered Eridian Basalt (warm dark volcanic stone) -->
    <texture name="rocky_basalt_base_tex" type="cube" file="rocky_basalt.png"/>
    <material name="rocky_carapace" texture="rocky_basalt_base_tex"
              rgba="0.72 0.71 0.70 1" metallic="0.06" roughness="0.80" specular="0.18"/>
    <material name="rocky_leg_upper" texture="rocky_basalt_base_tex"
              rgba="0.90 0.89 0.87 1" metallic="0.06" roughness="0.80" specular="0.18"/>
    <material name="rocky_leg_lower" texture="rocky_basalt_base_tex"
              rgba="1.00 0.98 0.96 1" metallic="0.06" roughness="0.80" specular="0.18"/>
  </asset>

  <default>
    <joint armature="0.2" damping="2.0" limited="true"/>
    <geom contype="1" conaffinity="0" size="0.15" condim="3" density="100.0"
          friction="1.0 0.01 0.001" margin="0" solref="0.015 1" material="rocky_leg_upper"/>
  </default>

  <worldbody>
    <body name="base" pos="0 0 1.25">
      <freejoint/>
      <geom name="base_geom4" pos="0 0 -0.18" size="0.42 0.42 0.58" type="ellipsoid" material="rocky_carapace"/>
      <geom name="base_geom6" fromto="0 0 -0.18 0 0 0.13" size="0.42" type="cylinder" material="rocky_carapace"/>

      <body name="front_left_leg_offsettable_xyz" pos="0.1 0.52 0">
        <joint axis="0 0 1" name="hip_fl" pos="0.0 0.0 0.0" range="-45 45" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0 0.47 -0.33" name="left_leg_geom" type="capsule" material="rocky_leg_upper"/>
        <body name="fl_knee_offsettable_xyz" pos="0 0.47 -0.33">
          <joint axis="1 0 0" name="ankle_fl" pos="0.0 0.0 0.0" range="0 60" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 0 0 -0.71" name="left_ankle_geom" size="0.142" type="capsule" material="rocky_leg_lower"/>
        </body>
      </body>

      <body name="front_right_leg_offsettable_xyz" pos="0.1 -0.52 0">
        <joint axis="0 0 1" name="hip_fr" pos="0.0 0.0 0.0" range="-45 45" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0 -0.47 -0.33" name="right_leg_geom" type="capsule" material="rocky_leg_upper"/>
        <body name="fr_knee_offsettable_xyz" pos="0 -0.47 -0.33">
          <joint axis="-1 0 0" name="ankle_fr" pos="0.0 0.0 0.0" range="0 60" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 0 0 -0.71" name="right_ankle_geom" size="0.142" type="capsule" material="rocky_leg_lower"/>
        </body>
      </body>

      <body name="back_leg_offsettable_xyz" pos="-0.52 0 0">
        <joint axis="0 0 1" name="hip_b" pos="0.0 0.0 0.0" range="-45 45" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 -0.47 0 -0.33" name="back_leg_geom" type="capsule" material="rocky_leg_upper"/>
        <body name="back_knee_offsettable_xyz" pos="-0.47 0 -0.33">
          <joint axis="0 1 0" name="ankle_b" pos="0.0 0.0 0.0" range="0 60" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 0 0 -0.71" name="third_ankle_geom" size="0.142" type="capsule" material="rocky_leg_lower"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="hip_fl"/>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="ankle_fl"/>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="hip_fr"/>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="ankle_fr"/>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="hip_b"/>
    <velocity ctrlrange="-6 6" forcerange="-180 180" kv="200" joint="ankle_b"/>
  </actuator>

  <keyframe>
    <key name="init_pos2" qpos="0 0 2   1 0 0 0   0.1 0.5   0.1 0.5   0.1 0.5" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
