<mujoco model="ant_arm">
  <compiler angle="degree" inertiafromgeom="true"/>

  <default>
    <!-- across all joints/geoms! -->
    <joint armature="3" damping="0.5" limited="true"/>
    <geom conaffinity="0" condim="3" density="1.0" friction="1 0.5 0.5" margin="0.01" rgba="0.8 0.6 0.4 1"/>

    <!-- <default class="arm_actuator">
      <position kp="10" dampratio="1" inheritrange="1" forcerange="-50 50"/>
    </default> -->

  </default>


  <!-- <asset>
    <texture builtin="gradient" height="100" rgb1="1 1 1" rgb2="0 0 0" type="skybox" width="100"/>
    <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
    <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
    <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
    <material name="geom" texture="texgeom" texuniform="true"/>
  </asset> -->

  <worldbody>

    <body name="torso_arm_offsettable_z_pos" pos="0 0 0">
      <geom name="torso_arm_geom" fromto="0 0 0 0 0 0.4" size="0.08" type="capsule"/>
      <body name="link0" pos="0 0 0.4">
        <joint name="joint_l0" pos="0 0 0" axis="0 0 1" range="-180 180"/>
        <geom name="l0_geom" fromto="0 0 0 0 0 0.4" size="0.07" type="capsule"/>
        <body name="torso_arm2" pos="0 0 0.4">
          <geom name="torso_arm_geom2" fromto="0 0 0 0.2 0 0" size="0.07" type="capsule"/>
          <body name="link1_offsettable_y_pos" pos="0.2 0 0">
            <joint name="joint_l1" pos="0 0 0" axis="1 0 0" range="-180 180"/>
            <geom name="l1_geom1" fromto="0 0 0 0 0.2 0" size="0.07" type="capsule"/>
            <body name="link2_offsettable_z_pos" pos="0 0.2 0">
              <joint name="joint_l2" pos="0 0 0" axis="0 1 0" range="-180 180"/>
              <geom name="l2_geom" fromto="0 0 0 0 0 -0.3" size="0.06" type="capsule"/>
              <body name="link3_offsettable_z_pos" pos="0 0 -0.3">
                <joint name="joint_l3" pos="0 0 0" axis="0 1 0" range="-150 150"/>
                <geom name="l3_geom" fromto="0 0 0 0 0 -0.3" size="0.05" type="capsule"/>
                <body name="link4_offsettable_z_pos" pos="0 0 -0.3">
                  <joint name="joint_l4" pos="0 0 0" axis="0 1 0" range="-150 150"/>
                  <geom name="l4_geom" fromto="0 0 0 0 0 -0.1" size="0.04" type="cylinder"/>
                  <body name="link5" pos="0 0 -0.1">
                    <joint name="joint_l5" pos="0 0 0" axis="0 0 1" range="-180 180"/>
                    <geom name="l5_geom" fromto="0 0 0 0 0 -0.1" size="0.04" type="cylinder"/>
                    <site name="arm_tip" pos="0 0 -0.1" quat="0 1 0 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>


  <actuator>
    <velocity joint="joint_l0" name="act0" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
    <velocity joint="joint_l1" name="act1" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
    <velocity joint="joint_l2" name="act2" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
    <velocity joint="joint_l3" name="act3" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
    <velocity joint="joint_l4" name="act4" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
    <velocity joint="joint_l5" name="act5" kv="200" ctrlrange="-3 3" forcerange="-60 60"/>
  </actuator>

  <keyframe>
    <key name="init_pos" qpos="0 0 2.5 1.2 0.7 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>

</mujoco>
