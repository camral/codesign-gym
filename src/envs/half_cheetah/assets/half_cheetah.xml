<!-- Cheetah Model — co-design port for codesign-gym.

    Vendored from Gymnasium (gymnasium/envs/mujoco/assets/half_cheetah.xml, MIT
    License, © Farama Foundation / OpenAI) and adapted to the codesign-gym
    "offsettable" contract: each designable limb is a single capsule running
    from its body origin (fromto="0 0 0 ..."), its body renamed
    "<name>_offsettable_xz" so the far end can be moved in the body-frame x/z
    plane per world. The head is extracted into its own welded body so it,
    too, is designable. The torso capsule and the free root are unchanged
    (torso length is not a design axis in this version).

    Geometry changes vs stock (all sub-centimetre; see GYM_MUJOCO_PORT_PLAN.md):
      - leg geoms rewritten from centered pos/axisangle to fromto-from-origin
        (thigh/shin span joint-to-joint; feet span origin to their true tip);
      - head moved from a 2nd torso geom into body "head_offsettable_xz".
    settotalmass="14" and inertiafromgeom="true" are retained, so total mass
    stays 14 and per-link inertia is recomputed by the offsettable kernel.

    State-Space (name/joint/parameter):
        - rootx     slider      position (m)
        - rootz     slider      position (m)
        - rooty     hinge       angle (rad)
        - bthigh    hinge       angle (rad)
        - bshin     hinge       angle (rad)
        - bfoot     hinge       angle (rad)
        - fthigh    hinge       angle (rad)
        - fshin     hinge       angle (rad)
        - ffoot     hinge       angle (rad)
        - (velocities follow, same order)

    Actuators: bthigh, bshin, bfoot, fthigh, fshin, ffoot (hinge torque).
-->
<mujoco model="cheetah">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <default>
    <joint armature=".1" damping=".01" limited="true" solimplimit="0 .8 .03" solreflimit=".02 1" stiffness="8"/>
    <geom density="640.2101645340" conaffinity="0" condim="3" contype="1" friction=".4 .1 .1" rgba="0.8 0.6 .4 1" solimp="0.0 0.8 0.01" solref="0.02 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  <size nstack="300000" nuser_geom="1"/>
  <option gravity="0 0 -9.81" timestep="0.01" iterations="30"/>
  <visual>
    <headlight diffuse="0.52 0.54 0.58" ambient="0.32 0.34 0.38" specular="0.12 0.12 0.12"/>
    <rgba haze="0.55 0.68 0.82 1"/>
    <quality shadowsize="2048"/>
    <map znear="0.01"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.72 0.84 0.96" rgb2="0.44 0.60 0.78" width="512" height="512"/>
    <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.20 0.30 0.40" rgb2="0.15 0.24 0.34" mark="edge" markrgb="0.26 0.36 0.46" width="256" height="256"/>
    <material name="MatPlane" texture="texplane" texuniform="true" texrepeat="1.2 1.2" reflectance="0.06" specular="0.12" shininess="0.25"/>
    <material name="geom" texture="texgeom" texuniform="true"/>
  </asset>
  <!-- The floor is enlarged for rendering; pin the stock extent so the camera clip planes stay as before. -->
  <statistic extent="8" center="0 0 0"/>
  <worldbody>
    <light directional="true" diffuse="0.82 0.84 0.86" specular="0.28 0.28 0.30" pos="2 -3 5" dir="-0.35 0.5 -1" castshadow="true"/>
    <light directional="true" diffuse="0.32 0.36 0.42" specular="0.06 0.06 0.08" pos="-3 2 4" dir="0.5 -0.35 -1" castshadow="false"/>
    <geom conaffinity="1" condim="3" material="MatPlane" name="floor" pos="0 0 0" rgba="1 1 1 1" size="1000 1000 40" type="plane"/>
    <body name="torso" pos="0 0 .7">
      <camera name="track" mode="trackcom" pos="0 -3 0.3" xyaxes="1 0 0 0 0 1"/>
      <joint armature="0" axis="1 0 0" damping="0" limited="false" name="rootx" pos="0 0 0" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 0" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 1 0" damping="0" limited="false" name="rooty" pos="0 0 0" stiffness="0" type="hinge"/>
      <!-- torso capsule split into torso_front / torso_rear halves below (designable) -->

      <body name="head_offsettable_xz" pos=".4854 0 .0033">
        <geom fromto="0 0 0 .2292 0 .1934" name="head" rgba="0.88 0.68 0.38 1" size="0.046" type="capsule"/>
      </body>
      <body name="torso_rear_offsettable_x" pos="0 0 0">
        <geom fromto="0 0 0 -.5 0 0" name="torso_rear" rgba="0.76 0.56 0.36 1" size="0.046" type="capsule"/>
      <body name="bthigh_offsettable_xz" pos="-.5 0 0">
        <joint axis="0 1 0" damping="6" name="bthigh" pos="0 0 0" range="-.52 1.05" stiffness="240" type="hinge"/>
        <geom fromto="0 0 0 .16 0 -.25" name="bthigh" rgba="0.84 0.58 0.34 1" size="0.046" type="capsule"/>
        <body name="bshin_offsettable_xz" pos=".16 0 -.25">
          <joint axis="0 1 0" damping="4.5" name="bshin" pos="0 0 0" range="-.785 .785" stiffness="180" type="hinge"/>
          <geom fromto="0 0 0 -.28 0 -.14" name="bshin" rgba="0.90 0.56 0.50 1" size="0.046" type="capsule"/>
          <body name="bfoot_offsettable_xz" pos="-.28 0 -.14">
            <joint axis="0 1 0" damping="3" name="bfoot" pos="0 0 0" range="-.4 .785" stiffness="120" type="hinge"/>
            <geom fromto="0 0 0 .0501 0 -.1812" name="bfoot" rgba="0.80 0.42 0.36 1" size="0.046" type="capsule"/>
          </body>
        </body>
      </body>
      </body>
      <body name="torso_front_offsettable_x" pos="0 0 0">
        <geom fromto="0 0 0 .5 0 0" name="torso_front" rgba="0.84 0.64 0.42 1" size="0.046" type="capsule"/>
      <body name="fthigh_offsettable_xz" pos=".5 0 0">
        <joint axis="0 1 0" damping="4.5" name="fthigh" pos="0 0 0" range="-1 .7" stiffness="180" type="hinge"/>
        <geom fromto="0 0 0 -.14 0 -.24" name="fthigh" rgba="0.84 0.58 0.34 1" size="0.046" type="capsule"/>
        <body name="fshin_offsettable_xz" pos="-.14 0 -.24">
          <joint axis="0 1 0" damping="3" name="fshin" pos="0 0 0" range="-1.2 .87" stiffness="120" type="hinge"/>
          <geom fromto="0 0 0 .13 0 -.18" name="fshin" rgba="0.90 0.56 0.50 1" size="0.046" type="capsule"/>
          <body name="ffoot_offsettable_xz" pos=".13 0 -.18">
            <joint axis="0 1 0" damping="1.5" name="ffoot" pos="0 0 0" range="-.5 .5" stiffness="60" type="hinge"/>
            <geom fromto="0 0 0 .0790 0 -.1155" name="ffoot" rgba="0.80 0.42 0.36 1" size="0.046" type="capsule"/>
          </body>
        </body>
      </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor gear="120" joint="bthigh" name="bthigh"/>
    <motor gear="90" joint="bshin" name="bshin"/>
    <motor gear="60" joint="bfoot" name="bfoot"/>
    <motor gear="120" joint="fthigh" name="fthigh"/>
    <motor gear="60" joint="fshin" name="fshin"/>
    <motor gear="30" joint="ffoot" name="ffoot"/>
  </actuator>
</mujoco>
