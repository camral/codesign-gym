<mujoco model="ant_arm">
  <compiler angle="degree" inertiafromgeom="true"/>

  <asset>
    <material name="spot_arm_yellow" rgba="0.96 0.74 0.08 1" metallic="0.15" roughness="0.34" specular="0.4"/>
    <material name="spot_arm_black" rgba="0.13 0.14 0.17 1" metallic="0.30" roughness="0.42" specular="0.35"/>
    <material name="spot_arm_metal" rgba="0.26 0.28 0.32 1" metallic="0.65" roughness="0.28" specular="0.5"/>
  </asset>

  <default>
    <!-- Realistic Boston Dynamics Spot Arm (~7.7 kg hollow aluminum/carbon links, ~0.1 kg*m^2 armature). -->
    <joint armature="0.1" damping="1.0" limited="true"/>
    <geom conaffinity="0" condim="3" density="220.0" friction="1.0 0.01 0.001" margin="0" solref="0.01 1" material="spot_arm_black"/>
  </default>

  <worldbody>
    <body name="torso_arm_offsettable_xyz" pos="0 0 0">
      <geom name="torso_arm_geom" fromto="0 0 0 0 0 0.4" size="0.08" type="capsule" material="spot_arm_yellow"/>
      <body name="link0_offsettable_xyz" pos="0 0 0.4">
        <joint name="joint_l0" pos="0 0 0" axis="0 0 1" range="-180 180"/>
        <geom name="l0_geom" fromto="0 0 0 0 0 0.4" size="0.07" type="capsule" material="spot_arm_yellow"/>
        <body name="torso_arm2_offsettable_xyz" pos="0 0 0.4">
          <geom name="torso_arm_geom2" fromto="0 0 0 0.2 0 0" size="0.07" type="capsule" material="spot_arm_metal"/>
          <body name="link1_offsettable_xyz" pos="0.2 0 0">
            <joint name="joint_l1" pos="0 0 0" axis="1 0 0" range="-180 180"/>
            <geom name="l1_geom1" fromto="0 0 0 0 0.2 0" size="0.07" type="capsule"/>
            <body name="link2_offsettable_xyz" pos="0 0.2 0">
              <joint name="joint_l2" pos="0 0 0" axis="0 1 0" range="-180 180"/>
              <geom name="l2_geom" fromto="0 0 0 0 0 -0.3" size="0.06" type="capsule"/>
              <body name="link3_offsettable_xyz" pos="0 0 -0.3">
                <joint name="joint_l3" pos="0 0 0" axis="0 1 0" range="-150 150"/>
                <geom name="l3_geom" fromto="0 0 0 0 0 -0.3" size="0.05" type="capsule"/>
                <body name="link4_offsettable_xyz" pos="0 0 -0.3">
                  <joint name="joint_l4" pos="0 0 0" axis="0 1 0" range="-150 150"/>
                  <geom name="l4_geom" fromto="0 0 0 0 0 -0.1" size="0.04" type="cylinder" material="spot_arm_metal"/>
                  <body name="link5_offsettable_xyz" pos="0 0 -0.1">
                    <joint name="joint_l5" pos="0 0 0" axis="0 0 1" range="-180 180"/>
                    <geom name="l5_geom" fromto="0 0 0 0 0 -0.1" size="0.04" type="cylinder" material="spot_arm_metal"/>
                    <site name="arm_tip" pos="0 0 -0.1" quat="0 1 0 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity joint="joint_l0" name="act0" kv="200" ctrlrange="-3 3" forcerange="-80 80"/>
    <velocity joint="joint_l1" name="act1" kv="200" ctrlrange="-3 3" forcerange="-80 80"/>
    <velocity joint="joint_l2" name="act2" kv="200" ctrlrange="-3 3" forcerange="-80 80"/>
    <velocity joint="joint_l3" name="act3" kv="200" ctrlrange="-3 3" forcerange="-80 80"/>
    <velocity joint="joint_l4" name="act4" kv="200" ctrlrange="-3 3" forcerange="-40 40"/>
    <velocity joint="joint_l5" name="act5" kv="200" ctrlrange="-3 3" forcerange="-40 40"/>
  </actuator>

  <keyframe>
    <key name="init_pos" qpos="0 0 2.5 1.2 0.7 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>

</mujoco>
