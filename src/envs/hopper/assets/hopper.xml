<!-- Hopper Model — co-design port for codesign-gym.

    Vendored from Gymnasium (gymnasium/envs/mujoco/assets/hopper.xml, MIT
    License, © Farama Foundation / OpenAI) and adapted to the codesign-gym
    "offsettable" contract.

    Designable links (renamed "<name>_offsettable_xz", deformable in the x/z
    plane of motion): thigh and leg.
      - thigh: its geom already runs from the body origin (pos = dir*half); only
        renamed. Its child (leg) is relocated to sit at the thigh's far end.
      - leg: the stock leg geom is centered on the body origin, so the leg body
        frame is RELOCATED onto its hinge (an exact re-parameterization: the
        body_pos, joint pos, geom and foot child all shift together so the world
        geometry at rest is byte-identical to stock) and the geom re-authored as
        fromto="0 0 0 0 0 -0.5" from the new origin.

    Left fixed in this version:
      - torso: the planar free root (carries rootx/rootz/rooty + the thigh child).
      - foot: a rotated horizontal capsule straddling an offset ankle (heel + toe
        around the joint), which is not a single origin-anchored link.

    inertiafromgeom stays true, so per-link inertia is recomputed by the
    offsettable kernel from the deformed geometry; the RK4 integrator, contacts,
    friction and all other options are unchanged.
-->
<mujoco model="hopper">
  <compiler angle="degree" inertiafromgeom="true"/>
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom conaffinity="1" condim="1" contype="1" margin="0.001" rgba="0.8 0.6 0.4 1" solimp=".8 .8 .01" solref=".02 1"/>
    <motor ctrllimited="true" ctrlrange="-.4 .4"/>
  </default>
  <option integrator="RK4" timestep="0.002" iterations="30"/>
  <visual>
    <headlight diffuse="0.52 0.54 0.58" ambient="0.32 0.34 0.38" specular="0.12 0.12 0.12"/>
    <rgba haze="0.55 0.68 0.82 1"/>
    <quality shadowsize="2048"/>
    <map znear="0.02"/>
  </visual>
  <!-- The floor is enlarged for rendering; pin the stock extent so the camera clip planes stay as before. -->
  <statistic extent="4.5" center="0 0 0.25"/>
  <worldbody>
    <light directional="true" diffuse="0.82 0.84 0.86" specular="0.28 0.28 0.30" pos="2 -3 5" dir="-0.35 0.5 -1" castshadow="true"/>
    <light directional="true" diffuse="0.32 0.36 0.42" specular="0.06 0.06 0.08" pos="-3 2 4" dir="0.5 -0.35 -1" castshadow="false"/>
    <geom conaffinity="1" condim="3" name="floor" pos="0 0 0" rgba="1 1 1 1" size="1000 1000 .125" type="plane" material="MatPlane"/>
    <body name="torso" pos="0 0 1.25">
      <camera name="track" mode="trackcom" pos="0 -3 -0.25" xyaxes="1 0 0 0 0 1"/>
      <joint armature="0" axis="1 0 0" damping="0" limited="false" name="rootx" pos="0 0 -1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 -1.25" ref="1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 1 0" damping="0" limited="false" name="rooty" pos="0 0 0" stiffness="0" type="hinge"/>
      <!-- Torso split onto a hub root so its length becomes designable: upper
           (head side) and lower (leg side) halves, each an origin-anchored
           offsettable capsule welded to the root. Reproduces the stock centered
           torso capsule (-.2..+.2) as two halves meeting at the origin. -->
      <body name="torso_upper_offsettable_z" pos="0 0 0">
        <geom friction="0.9" name="torso_upper_geom" rgba="0.86 0.66 0.42 1" fromto="0 0 0 0 0 0.19999999999999996" size="0.05" type="capsule"/>
      </body>
      <body name="torso_lower_offsettable_z" pos="0 0 0">
        <geom friction="0.9" name="torso_lower_geom" rgba="0.76 0.56 0.36 1" fromto="0 0 0 0 0 -0.19999999999999996" size="0.05" type="capsule"/>
        <body name="thigh_offsettable_xz" pos="0 0 -0.19999999999999996">
          <joint axis="0 -1 0" name="thigh_joint" pos="0 0 0" range="-150 0" type="hinge"/>
          <geom friction="0.9" pos="0 0 -0.22500000000000009" name="thigh_geom" rgba="0.86 0.58 0.34 1" size="0.05 0.22500000000000003" type="capsule"/>
          <body name="leg_offsettable_xz" pos="0 0 -0.45000000000000001">
            <joint axis="0 -1 0" name="leg_joint" pos="0 0 0" range="-150 0" type="hinge"/>
            <geom friction="0.9" fromto="0 0 0 0 0 -0.5" name="leg_geom" rgba="0.88 0.54 0.46 1" size="0.04" type="capsule"/>
            <body name="foot" pos="0.13 0 -0.6">
              <joint axis="0 -1 0" name="foot_joint" pos="-0.13 0 0.1" range="-45 45" type="hinge"/>
              <!-- Foot split at the ankle into designable toe/heel capsules (the
                   stock foot is a horizontal capsule straddling the ankle). -->
              <body name="foot_toe_offsettable_x" pos="-0.13 0 0.1">
                <geom friction="2.0" fromto="0 0 0 0.26 0 0" name="foot_toe_geom" rgba="0.82 0.44 0.34 1" size="0.06" type="capsule"/>
              </body>
              <body name="foot_heel_offsettable_x" pos="-0.13 0 0.1">
                <geom friction="2.0" fromto="0 0 0 -0.13 0 0" name="foot_heel_geom" rgba="0.68 0.38 0.30 1" size="0.06" type="capsule"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" joint="thigh_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" joint="leg_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="200.0" joint="foot_joint"/>
  </actuator>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.72 0.84 0.96" rgb2="0.44 0.60 0.78" width="512" height="512"/>
        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1="0.20 0.30 0.40" rgb2="0.15 0.24 0.34" mark="edge" markrgb="0.26 0.36 0.46" width="256" height="256"/>
        <material name="MatPlane" texture="texplane" texuniform="true" texrepeat="1.2 1.2" reflectance="0.06" specular="0.12" shininess="0.25"/>
        <material name="geom" texture="texgeom" texuniform="true"/>
    </asset>
</mujoco>
